# Base URL of the backend API. Defaults to http://localhost:8000 when unset.
# Copy this file to .env.local and change the value if the backend runs elsewhere.
VITE_API_BASE_URL=http://localhost:8000

# The chat assistant is hidden until the backend confirms its endpoints.
# Set to 1 to show the "Ask Banyan" button.
# VITE_ENABLE_ASSISTANT=1
