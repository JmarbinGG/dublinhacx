# AI photo suggestions (optional). With a key set, the NVIDIA backend is used;
# without one, a mock classifier fills in placeholder suggestions.
NVIDIA_API_KEY=
# NVIDIA_VLM_MODEL=meta/llama-3.2-11b-vision-instruct
# AI_BACKEND=mock        # mock | nvidia | clip

# Extra allowed frontend origins (comma-separated). Localhost, LAN IPs and
# ngrok tunnels are allowed by default.
# CORS_ORIGINS=https://byproduct.example.com

# DATABASE_URL=sqlite:///./marketplace.db
# ENABLE_DOCS=1          # set to 0 to hide /docs in production
