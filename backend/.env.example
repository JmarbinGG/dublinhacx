# Defaults to sqlite:///./app.db
DATABASE_URL=

# Go AI search service. Unset = built-in keyword search.
SEARCH_SERVICE_URL=
# Shared secret the search service sends as X-Search-Key to GET /api/search/corpus.
SEARCH_SERVICE_KEY=

# Qwen chat (OpenAI-compatible API), e.g. http://localhost:11434/v1 for Ollama.
# Unset = POST /api/chat returns 503.
CHAT_SERVICE_URL=
CHAT_MODEL=qwen2.5
CHAT_API_KEY=
