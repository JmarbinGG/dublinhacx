# Defaults to sqlite:///./app.db
DATABASE_URL=

# AI search service (Qwen embeddings). Unset = built-in keyword search.
SEARCH_SERVICE_URL=
# Shared secret the search service sends as X-Search-Key to GET /api/search/corpus.
SEARCH_SERVICE_KEY=

# "production" locks down CORS (CORS_ORIGINS only) and requires SEARCH_SERVICE_KEY.
APP_ENV=
# Extra allowed frontend origins, comma-separated (deployed site, ngrok URL).
CORS_ORIGINS=
# Set to 1 only behind our own reverse proxy/tunnel so rate limits use X-Forwarded-For.
TRUST_PROXY=

# Qwen LLM for /api/search/ai and /api/assistant (any OpenAI-compatible API),
# e.g. http://localhost:11434/v1 for Ollama. Unset = keyword fallbacks.
LLM_SERVICE_URL=
LLM_MODEL=qwen2.5
LLM_API_KEY=
AI_TIMEOUT_S=12
AI_DAILY_CALL_CAP=2000
AI_DAILY_TOKEN_CAP=2000000
